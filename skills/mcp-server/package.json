{
  "name": "@parad0x_labs/mcp-server",
  "version": "0.2.1",
  "description": "MCP server for the Parad0x Labs stack: x402 payment quotes, receipt hashing, read-only .null and Dark Passport lookups, outcome receipts, Liquefy-format receipt compression",
  "type": "module",
  "bin": {
    "parad0x-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Parad0x-Labs/openclaw-skills.git",
    "directory": "skills/mcp-server"
  },
  "homepage": "https://github.com/Parad0x-Labs/openclaw-skills/tree/main/skills/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/Parad0x-Labs/openclaw-skills/issues"
  }
}
